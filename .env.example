# ─────────────────────────────────────────────────────────────────────────────
# NyayaNode — Environment Variables
# Copy this file to backend/.env and fill in your values.
#
#   Windows:  Copy-Item .env.example backend\.env
#   Mac/Linux: cp .env.example backend/.env
#
# NEVER commit backend/.env — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
# Project URL  (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=

# Anon / public key  (safe for client-side, limited by RLS)
SUPABASE_ANON_KEY=

# Service role key  (bypasses RLS — keep secret, server-side only)
SUPABASE_SERVICE_KEY=

# ── Backend auth ──────────────────────────────────────────────────────────────
# Any string you choose — sent as X-API-Key header by the frontend and scripts.
# Change this before deploying to production.
BACKEND_API_KEY=nyayanode-internal-secret-key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (*.vercel.app is already allowed by regex).
# Set this to your exact deployment URL to also allow it explicitly.
FRONTEND_URL=https://nyayanode.vercel.app

# ── Agent module ──────────────────────────────────────────────────────────────
# Python import path for Member 1's arbitrator.
# Leave as-is until Member 1 pushes their code.
# The server starts fine without it (falls back to the built-in stub).
AGENT_MODULE_PATH=agents.core.arbitrator

# ── Server ────────────────────────────────────────────────────────────────────
# Railway injects $PORT automatically — you don't need to set this on Railway.
# For local dev the default 8000 is used.
PORT=8000
