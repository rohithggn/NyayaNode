# =============================================================================
# NyayaNode — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. .env is in .gitignore.
#
# MEMBER OWNERSHIP:
#   Member 1 (Agents)    → GROQ_*, HINDSIGHT_*, CASCADEFLOW_*
#   Member 3 (Backend)   → SUPABASE_*, BACKEND_*
#   Member 4 (Frontend)  → NEXT_PUBLIC_*
#   All members need:    → SUPABASE_URL, SUPABASE_ANON_KEY
# =============================================================================

# ── LLM Provider (Groq) ─────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_HEAVY_MODEL=llama-3.3-70b-versatile
GROQ_LIGHT_MODEL=llama-3.1-8b-instant

# ── Sponsor: Hindsight (Memory + Rollback) ───────────────────────────────────
HINDSIGHT_API_KEY=hs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HINDSIGHT_PROJECT_ID=nyayanode-prod
HINDSIGHT_BASE_URL=https://api.hindsight.ai/v1

# ── Sponsor: Cascadeflow (Cost Router) ──────────────────────────────────────
CASCADEFLOW_API_KEY=cf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CASCADEFLOW_PROJECT_ID=nyayanode
CASCADEFLOW_BASE_URL=https://api.cascadeflow.io/v1
CASCADEFLOW_BUDGET_CAP_INR=5.0

# ── Database (Supabase) ──────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Agent Service ────────────────────────────────────────────────────────────
AGENT_HOST=0.0.0.0
AGENT_PORT=8001
AGENT_LOG_LEVEL=INFO
AGENT_ENV=development        # development | staging | production

# ── Backend Service (Member 3) ───────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_AGENT_URL=http://localhost:8001    # Points to agent service

# ── Frontend (Member 4) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ONDC Network Config ──────────────────────────────────────────────────────
ONDC_SUBSCRIBER_ID=nyayanode.example.com
ONDC_GATEWAY_URL=https://pilot-gateway-1.beckn.delhivery.com/search

# ── Logistics API Stubs (replace with real credentials) ─────────────────────
DELHIVERY_API_KEY=xxxxxxxxxxxxxxxxxxxx
DELHIVERY_BASE_URL=https://track.delhivery.com/api/v1
BLUEDART_API_KEY=xxxxxxxxxxxxxxxxxxxx
DTDC_API_KEY=xxxxxxxxxxxxxxxxxxxx

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string-before-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
