{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "cd frontend && npm install",
  "routes": [
    {
      "src": "/api/agents/(.*)",
      "dest": "https://nyayanode-agents.railway.app/agents/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://nyayanode-backend.railway.app/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
